# Copy this file to .env and fill the ACCESS_KEY provided by Spot
ACCESS_KEY=your_access_key_here
SPOT_BASE=https://ws.spotgifts.com.br/api/v1SSL/
PORT=3000

# Comma-separated browser origins allowed to call the API from another domain.
# Leave empty when the site and API are served from the same domain.
CORS_ALLOWED_ORIGINS=https://www.brucspersonalizados.com.br

# Required only to enable the administrative Spot order routes.
# Keep this secret out of browser code.
ORDER_ADMIN_KEY=replace_with_a_long_random_secret
